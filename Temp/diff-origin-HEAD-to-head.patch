diff --git a/src/utils/mathRenderer.ts b/src/utils/mathRenderer.ts
new file mode 100644
index 0000000..ab09ee9
--- /dev/null
+++ b/src/utils/mathRenderer.ts
@@ -0,0 +1,175 @@
+import katex from "katex";
+
+/**
+ * LaTeX math formula rendering utility
+ * Uses KaTeX library to convert LaTeX formulas to HTML
+ * Supports $...$ (inline), $$...$$, \(...\) (inline), and \[...\] (display) formats
+ */
+export function renderMathInText(text: string): string {
+  if (!text) {
+    return text;
+  }
+
+  const hasMath = containsMath(text);
+  if (!hasMath) {
+    return text;
+  }
+
+  // Process display math formulas first: $$...$$ and \[...\]
+  let processed = text
+    // Process $$...$$ format
+    .replace(/\$\$([\s\S]*?)\$\$/g, (match, latex) => {
+      try {
+        const html = katex.renderToString(latex.trim(), {
+          displayMode: true,
+          throwOnError: false,
+          errorColor: "#cc0000",
+          strict: false
+        });
+        return html;
+      } catch (error) {
+        return match; // Return original text on rendering failure
+      }
+    })
+    // Process \[...\] format
+    .replace(/\\\[([\s\S]*?)\\\]/g, (match, latex) => {
+      try {
+        const html = katex.renderToString(latex.trim(), {
+          displayMode: true,
+          throwOnError: false,
+          errorColor: "#cc0000",
+          strict: false
+        });
+        return html;
+      } catch (error) {
+        return match; // Return original text on rendering failure
+      }
+    });
+
+  // Process inline math formulas: $...$ and \(...\) (avoid conflicts with display mode)
+  processed = processed
+    // Process $...$ format (avoid conflicts with $$...$$)
+    .replace(/(?<!\$)\$(?!\$)(.*?)\$(?!\$)/g, (match, latex) => {
+      try {
+        const html = katex.renderToString(latex.trim(), {
+          displayMode: false,
+          throwOnError: false,
+          errorColor: "#cc0000",
+          strict: false
+        });
+        return html;
+      } catch (error) {
+        return match; // Return original text on rendering failure
+      }
+    })
+    // Process \(...\) format
+    .replace(/\\\(([\s\S]*?)\\\)/g, (match, latex) => {
+      try {
+        const html = katex.renderToString(latex.trim(), {
+          displayMode: false,
+          throwOnError: false,
+          errorColor: "#cc0000",
+          strict: false
+        });
+        return html;
+      } catch (error) {
+        return match; // Return original text on rendering failure
+      }
+    });
+
+  return processed;
+}
+
+/**
+ * Render LaTeX math formulas directly into a DOM element
+ * Supports $...$ (inline), $$...$$, \(...\) (inline), and \[...\] (display) formats
+ */
+export function renderMathInElement(element: HTMLElement, text: string): void {
+  if (!element || !text) return;
+  
+  // Use innerHTML to set rendered HTML
+  element.innerHTML = renderMathInText(text);
+}
+
+/**
+ * Check if text contains LaTeX math formulas
+ * @param text Text to check
+ * @returns Whether text contains math formulas
+ */
+export function containsMath(text: string): boolean {
+  if (!text) return false;
+  // Check for $...$, $$...$$, \(...\), or \[...\] format math formulas
+  return /\$\$[\s\S]*?\$\$|\$[^$]*?\$|\\\([\s\S]*?\\\)|\\\[[\s\S]*?\\\]/.test(text);
+}
+
+/**
+ * Escape HTML special characters (for non-math text portions)
+ */
+export function escapeHtml(text: string): string {
+  const div = Zotero.getMainWindow().document.createElement('div');
+  div.textContent = text;
+  return div.innerHTML;
+}
+
+/**
+ * Safe rendering of mixed text and math formulas
+ * HTML-escapes non-math portions, renders math portions with KaTeX
+ */
+export function renderMathSafely(text: string): string {
+  if (!text) return text;
+  
+  let result = '';
+  let lastIndex = 0;
+  
+  // Match all math formulas ($$...$$, $...$, \(...\), and \[...\])
+  const mathRegex = /\$\$[\s\S]*?\$\$|\$[^$]*?\$|\\\([\s\S]*?\\\)|\\\[[\s\S]*?\\\]/g;
+  let match;
+  
+  while ((match = mathRegex.exec(text)) !== null) {
+    // Add escaped plain text before math formula
+    if (match.index > lastIndex) {
+      const plainText = text.slice(lastIndex, match.index);
+      result += escapeHtml(plainText);
+    }
+    
+    // Render math formula
+    const mathText = match[0];
+    let latex: string;
+    let displayMode: boolean;
+    
+    if (mathText.startsWith('$$')) {
+      latex = mathText.slice(2, -2).trim();
+      displayMode = true;
+    } else if (mathText.startsWith('\\[')) {
+      latex = mathText.slice(2, -2).trim();
+      displayMode = true;
+    } else if (mathText.startsWith('\\(')) {
+      latex = mathText.slice(2, -2).trim();
+      displayMode = false;
+    } else {
+      latex = mathText.slice(1, -1).trim();
+      displayMode = false;
+    }
+    
+    try {
+      const html = katex.renderToString(latex, {
+        displayMode: displayMode,
+        throwOnError: false,
+        errorColor: "#cc0000",
+        strict: false
+      });
+      result += html;
+    } catch (error) {
+      result += escapeHtml(mathText); // Return escaped original text on rendering failure
+    }
+    
+    lastIndex = match.index + match[0].length;
+  }
+  
+  // Add remaining plain text
+  if (lastIndex < text.length) {
+    result += escapeHtml(text.slice(lastIndex));
+  }
+  
+  return result || escapeHtml(text);
+}
